import { Button, VerticalBox, HorizontalBox, Palette } from "std-widgets.slint";

export { Palette }

export component AppWindow inherits Window {
    title: "AI Variable Manager";
    min-width: 960px;
    min-height: 640px;
    preferred-width: 1120px;
    preferred-height: 720px;
    background: Palette.background;

    in-out property <bool> dark-mode: Palette.color-scheme == ColorScheme.dark;
    in-out property <string> active-tab: "projetos";
    in-out property <string> status-text: "Banco SQLite local conectado (100% offline)";

    callback toggle-theme-requested();

    VerticalBox {
        padding: 20px;
        spacing: 16px;

        // Barra superior persistente
        Rectangle {
            background: Palette.alternate-background;
            border-color: Palette.border;
            border-width: 1px;
            border-radius: 6px;
            height: 64px;

            HorizontalBox {
                padding-left: 16px;
                padding-right: 16px;
                spacing: 12px;
                alignment: space-between;

                VerticalBox {
                    padding: 0px;
                    spacing: 2px;
                    alignment: center;

                    Text {
                        text: "AI Variable Manager";
                        font-size: 18px;
                        font-weight: 700;
                        color: Palette.foreground;
                    }

                    Text {
                        text: "Gerenciador de Dados Variáveis para Adobe Illustrator";
                        font-size: 12px;
                        color: Palette.foreground;
                        opacity: 0.75;
                    }
                }

                HorizontalBox {
                    padding: 0px;
                    spacing: 8px;
                    alignment: center;

                    Text {
                        text: root.dark-mode ? "Tema: Escuro" : "Tema: Claro";
                        color: Palette.foreground;
                        vertical-alignment: center;
                    }

                    Button {
                        text: root.dark-mode ? "Mudar para Claro" : "Mudar para Escuro";
                        clicked => {
                            root.toggle-theme-requested();
                        }
                    }
                }
            }
        }

        // Navegação pt-BR (shell M1 para vistas M2-M5)
        HorizontalBox {
            padding: 0px;
            spacing: 8px;

            Button {
                text: "Projetos";
                primary: root.active-tab == "projetos";
                clicked => { root.active-tab = "projetos"; }
            }
            Button {
                text: "Dados";
                primary: root.active-tab == "dados";
                clicked => { root.active-tab = "dados"; }
            }
            Button {
                text: "Fotografias";
                primary: root.active-tab == "fotos";
                clicked => { root.active-tab = "fotos"; }
            }
            Button {
                text: "XML & Exportação";
                primary: root.active-tab == "xml";
                clicked => { root.active-tab = "xml"; }
            }
            Button {
                text: "Configurações";
                primary: root.active-tab == "config";
                clicked => { root.active-tab = "config"; }
            }
        }

        // Área principal placeholder M1
        Rectangle {
            vertical-stretch: 1;
            background: Palette.alternate-background;
            border-color: Palette.border;
            border-width: 1px;
            border-radius: 6px;

            VerticalBox {
                padding: 24px;
                spacing: 12px;
                alignment: center;

                Text {
                    text: "Shell Fluent M1 — Aba ativa: " + root.active-tab;
                    font-size: 16px;
                    font-weight: 600;
                    color: Palette.foreground;
                    horizontal-alignment: center;
                }

                Text {
                    text: root.status-text;
                    font-size: 13px;
                    color: Palette.foreground;
                    opacity: 0.85;
                    horizontal-alignment: center;
                }
            }
        }
    }
}
