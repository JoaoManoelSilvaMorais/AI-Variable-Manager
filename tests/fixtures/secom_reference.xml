            <variable category="&ns_flows;" trait="textcontent" varName="NomeFuncionario"></variable>
            <variable category="&ns_flows;" trait="textcontent" varName="FuncaoFuncionario"></variable>
            <variable category="&ns_imrep;" trait="fileref" varName="FotoFuncionario"></variable>
        </variables>

        <v:sampleDataSets xmlns:v="&ns_vars;" xmlns="&ns_custom;">
            <v:sampleDataSet dataSetName="01 - Ana Cláudia Ferreira de Souza">
                <NomeFuncionario><p>Ana Cláudia Ferreira de Souza</p></NomeFuncionario>
                <FuncaoFuncionario><p>Designer Gráfico</p></FuncaoFuncionario>
                <FotoFuncionario>D:\Crachas\01_ana_claudia.png</FotoFuncionario>
            </v:sampleDataSet>
            <v:sampleDataSet dataSetName="02 - João Pedro Conceição Júnior">
                <NomeFuncionario><p>João Pedro Conceição Júnior</p></NomeFuncionario>
                <FuncaoFuncionario><p>Técnico em Comunicação / Audiovisual</p></FuncaoFuncionario>
                <FotoFuncionario>D:\Crachas\02_joao_pedro.jpg</FotoFuncionario>
            </v:sampleDataSet>
            <v:sampleDataSet dataSetName="03 - Márcia Helena Órgão da Silva">
                <NomeFuncionario><p>Márcia Helena Órgão da Silva</p></NomeFuncionario>
                <FuncaoFuncionario><p>Coordenadora de Assistência</p></FuncaoFuncionario>
                <FotoFuncionario>D:\Crachas\03_marcia_helena.jpeg</FotoFuncionario>
            </v:sampleDataSet>
        </v:sampleDataSets>
    </variableSet>
</variableSets>
</svg>
